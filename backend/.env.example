# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-super-secret

# Postgres
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis (BullMQ + rate-limit counters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Ethereal SMTP (fake SMTP for testing)
# Get creds by running: node scripts/create-ethereal-account.js
# Or just sign up at https://ethereal.email
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=
ETHEREAL_SMTP_PASS=

# You can configure multiple senders as JSON. Each sender gets its own
# hourly rate-limit bucket. If ETHEREAL creds differ per sender, list them
# here; otherwise all senders share one Ethereal inbox for the demo.
SENDERS_JSON=[{"id":"sender1","name":"Alex from ReachInbox","email":"alex@reachinbox.test"},{"id":"sender2","name":"Sam from ReachInbox","email":"sam@reachinbox.test"}]

# Rate limiting (overridable per-sender via API too)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack OAuth (for rate-limit-hit notifications)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
